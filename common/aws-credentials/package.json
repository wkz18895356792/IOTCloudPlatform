{
  "name": "@baby-monitor/aws-credentials",
  "version": "1.0.0",
  "description": "AWS STS temporary credentials manager for Baby Monitor Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-sts": "^3.600.0",
    "@aws-sdk/types": "^3.600.0",
    "@midwayjs/core": "^3.0.0",
    "@midwayjs/redis": "^3.0.0",
    "@midwayjs/logger": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
